// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@map("users")
}

model Project {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  title     String?
  status    ProjectStatus @default(CREATED)
  style     NarrativeStyle @default(DRAMATIC)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos    Video[]
  scenes    Scene[]
  narrative Narrative?
  exports   Export[]

  @@index([userId])
  @@index([status])
  @@map("projects")
}

model Video {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  filename   String
  originalName String @map("original_name")
  path       String
  duration   Float?
  resolution String?
  fps        Float?
  size       BigInt
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  Scene[]

  @@index([projectId])
  @@map("videos")
}

model Scene {
  id             String  @id @default(uuid())
  videoId        String  @map("video_id")
  projectId      String  @map("project_id")
  startTime      Float   @map("start_time")
  endTime        Float   @map("end_time")
  description    String?
  emotions       Json?
  speakers       Json?
  transcription  String? @db.Text
  importanceScore Float? @map("importance_score")
  metadata       Json?

  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([projectId])
  @@index([importanceScore])
  @@map("scenes")
}

model Narrative {
  id        String   @id @default(uuid())
  projectId String   @unique @map("project_id")
  structure Json     // Estrutura completa de atos, personagens, etc
  narrations Json?   // Textos e configurações de narração
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("narratives")
}

model Export {
  id         String     @id @default(uuid())
  projectId  String     @map("project_id")
  type       ExportType
  filename   String
  path       String
  duration   Float?
  resolution String?
  size       BigInt?
  metadata   Json?
  createdAt  DateTime   @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@map("exports")
}

model WhatsAppSession {
  id        String   @id @default(uuid())
  phone     String   @unique
  sessionData Json?  @map("session_data")
  projectId String?  @map("project_id")
  stage     String?
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_sessions")
}

model SocialPage {
  id                String            @id @default(uuid())
  handle            String            @unique
  niche             String
  followers         Int               @default(0)
  averageReach      Int               @default(0) @map("average_reach")
  postingFrequency  Int               @default(0) @map("posting_frequency")
  officialConnected Boolean           @default(false) @map("official_connected")
  accessToken       String?           @map("access_token")
  tokenExpiresAt    DateTime?         @map("token_expires_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  dailyMetrics      DailyMetric[]
  revenueEntries    RevenueEntry[]
  strategyInsights  StrategyInsight[]

  @@index([niche])
  @@index([officialConnected])
  @@map("social_pages")
}

model DailyMetric {
  id              String    @id @default(uuid())
  pageId          String    @map("page_id")
  date            DateTime
  impressions     Int       @default(0)
  reach           Int       @default(0)
  likes           Int       @default(0)
  comments        Int       @default(0)
  shares          Int       @default(0)
  saves           Int       @default(0)
  profileVisits   Int       @default(0) @map("profile_visits")
  followersDelta  Int       @default(0) @map("followers_delta")
  createdAt       DateTime  @default(now()) @map("created_at")

  page            SocialPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date])
  @@index([date])
  @@map("daily_metrics")
}

model RevenueEntry {
  id           String      @id @default(uuid())
  pageId        String      @map("page_id")
  date          DateTime
  source        RevenueSource
  amount        Float
  currency      String      @default("BRL")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  page          SocialPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, date])
  @@index([source])
  @@map("revenue_entries")
}

model StrategyInsight {
  id                   String      @id @default(uuid())
  pageId               String      @map("page_id")
  date                 DateTime    @default(now())
  engagementScore      Float       @map("engagement_score")
  monetizationScore    Float       @map("monetization_score")
  growthScore          Float       @map("growth_score")
  recommendation       String      @db.Text
  priority             InsightPriority
  createdAt            DateTime    @default(now()) @map("created_at")

  page                 SocialPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, date])
  @@index([priority])
  @@map("strategy_insights")
}

enum ProjectStatus {
  CREATED
  UPLOADING
  ANALYZING
  SHOWRUNNING
  NARRATING
  EDITING
  EXPORTING
  COMPLETED
  FAILED
}

enum NarrativeStyle {
  DRAMATIC
  IRONIC
  DOCUMENTARY
  MINIMALIST
}

enum ExportType {
  EPISODE
  SHORT_15
  SHORT_30
  SHORT_60
  TEASER
}

enum RevenueSource {
  AFFILIATE
  BRAND_DEAL
  PRODUCT
  TRAFFIC
  OTHER
}

enum InsightPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
